# ─── Imposter Game – Environment Variables ───────────────────────────────────
#
# Copy this file to .env (for client vars) and server/.env (for server vars).
# NEVER commit a real .env file to version control.
#
# Quick start:
#   cp .env.example .env
#   cp .env.example server/.env

# ── Client (Vite) ───────────────────────────────────────────────────────────
# All client env vars must be prefixed with VITE_ to be exposed to the browser.

# Socket.IO server URL. Leave EMPTY for local dev (Vite proxy forwards
# /socket.io to localhost:3001) or when client+server share one domain in
# production. If you deploy the client and server to DIFFERENT domains
# (e.g. client on Vercel/Netlify, server on Render/Railway/Fly), set this to
# the server's public URL, e.g.:
#   VITE_SOCKET_URL=https://imposter-game-server.onrender.com
VITE_SOCKET_URL=

# App environment – shown in dev tooling only
VITE_APP_ENV=development

# ── Server (Node / Express) ─────────────────────────────────────────────────
# TCP port the Express server listens on
PORT=3001

# Set to 'production' to enable JSON logging and strip sensitive info from
# the health endpoint.  Vite dev mode already sets VITE_APP_ENV above.
NODE_ENV=development

# Comma-separated list of allowed CORS origins (no trailing slash).
# In production, set this to your exact front-end domain:
#   CORS_ORIGINS=https://game.yourdomain.com
# This MUST match wherever the client is actually hosted, or both the
# REST health check and the Socket.IO handshake will be rejected by CORS.
CORS_ORIGINS=http://localhost:5100,http://localhost:5173
