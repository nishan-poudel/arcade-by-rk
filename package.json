{
  "name": "imposter-game",
  "version": "1.0.0",
  "author": "Nishan",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c cyan,magenta \"cd server && npm run dev\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test": "mocha",
    "test:watch": "mocha --watch --watch-extensions ts",
    "server:install": "cd server && npm install"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.4.19",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.19",
    "chai": "^6.2.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "happy-dom": "^17.6.1",
    "jsdom": "^26.1.0",
    "mocha": "^11.7.5",
    "prettier": "^3.1.1",
    "sass": "^1.97.3",
    "sass-embedded": "^1.97.3",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^3.3.6"
  }
}
