{
  "name": "@callbreak/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --env production",
    "typecheck": "wrangler types && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@callbreak/shared-logic": "*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.8",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
